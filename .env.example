# Copie para .env e ajuste se necessário: cp .env.example .env

# Aplicação
APP_NAME="API Raízes do Nordeste"
APP_ENV=development

# Banco (deve bater com o docker-compose.yml)
POSTGRES_USER=raizes
POSTGRES_PASSWORD=raizes123
POSTGRES_DB=raizes_nordeste
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://raizes:raizes123@localhost:5432/raizes_nordeste

# Autenticação (troque o segredo em qualquer ambiente real)
JWT_SECRET=troque-este-segredo
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
